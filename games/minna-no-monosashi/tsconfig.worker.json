{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["vitest/globals", "@cloudflare/vitest-pool-workers/types"],
    "composite": true
  },
  "include": [
    "worker-configuration.d.ts",
    "src/worker",
    "src/domain",
    "src/shared",
    "test/worker"
  ]
}
